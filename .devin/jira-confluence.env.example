# Jira Configuration
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_MCP_URL=https://yourcompany.atlassian.net
JIRA_MCP_EMAIL=your.email@company.com
JIRA_MCP_TOKEN=your-api-token-here

# Confluence Configuration
# Confluence uses the same Atlassian account and API token as Jira
CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_EMAIL=your.email@company.com
CONFLUENCE_TOKEN=your-api-token-here

# Optional: Confluence API Version (v2 for Cloud, v1 for Server/Data Center)
CONFLUENCE_API_VERSION=v2

# Optional: MCP Transport (stdio for local, http for remote deployments)
MCP_TRANSPORT=stdio

# Optional: Read-only mode (true/false) - restricts write operations
CONFLUENCE_READ_ONLY=false
JIRA_READ_ONLY=false