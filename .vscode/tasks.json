{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Tests (Chromium - Dev - Headless)",
      "type": "shell",
      "command": "./gradlew.bat",
      "args": [
        "clean",
        "test",
        "-Denv=dev",
        "-Dbrowser=chromium",
        "-Dheadless=true"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "detail": "Run tests with Chromium browser in headless mode on dev environment"
    },
